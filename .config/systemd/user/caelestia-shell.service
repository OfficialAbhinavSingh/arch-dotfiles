[Unit]
Description=caelestia-shell (quickshell desktop shell)
Documentation=https://github.com/caelestia-dots/shell
# Deliberately NOT WantedBy/After=graphical-session.target: uwsm is installed but
# does not manage this session, so that target never activates (which is also why
# wallpaper-shuffle.service has never run). caelestia-launch, called from the
# hyprland.start block in hyprland.lua, starts this unit explicitly instead.
OnFailure=caelestia-fallback.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Refuse to start against a Qt it cannot link to. qt6-base minor bumps move
# symbols between version nodes and quickshell links Qt private API, so the
# installed binary can stop loading with no source change at all.
ExecStartPre=/usr/bin/quickshell --private-check-compat
# Foreground, no -d: systemd must own the process to be able to restart it.
# -n exits immediately if another instance of this config is already running.
ExecStart=/usr/bin/qs -c caelestia -n
Restart=always
RestartSec=2
# Once the shell is genuinely up, drop any fallback left over from a failure.
ExecStartPost=-/home/laterabhi/.local/bin/caelestia-fallback --stop
