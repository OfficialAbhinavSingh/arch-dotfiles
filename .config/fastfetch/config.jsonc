{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " ➜  "
    },
    "modules": [
        "break",
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "󰞷 Shell",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "󰍹 Resolution",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break",
        {
            "type": "custom",
            "format": "󰎆 Now Playing"
        },
        {
            "type": "player",
            "key": "  󰎆",
            "keyColor": "magenta"
        },
        {
            "type": "media",
            "key": "  󰝚",
            "keyColor": "magenta"
        }
    ]
}
