[Unit]
Description=Nudge the amdgpu panel backlight so the PWM is actually programmed
Documentation=https://gitlab.freedesktop.org/drm/amd/-/issues
# See /usr/local/bin/amdgpu-backlight-nudge for why this exists. The body lives
# in a script and not in ExecStart= because systemd expands %s (and %b, %u, ...)
# as unit specifiers, which silently corrupted the old inline printf.
After=systemd-backlight@backlight:amdgpu_bl1.service
Before=display-manager.service
ConditionPathExists=/sys/class/backlight/amdgpu_bl1/brightness

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/amdgpu-backlight-nudge

[Install]
WantedBy=graphical.target
