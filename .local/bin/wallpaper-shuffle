#!/bin/bash
# Shuffles to a random wallpaper from the active pack.
#
# caelestia picks and draws the wallpaper (it owns the background layer and
# regenerates the shell's material-you scheme from the image), then
# caelestia-theme re-runs wallust so rofi/kitty follow the same image.
#
# Default pack: caelestia-pack. Override with WALLDIR, e.g.
#   WALLDIR=~/Pictures/wallpapers/jjk-gojo-pack wallpaper-shuffle

WALLDIR="${WALLDIR:-$HOME/Pictures/wallpapers/caelestia-pack}"

if [ ! -d "$WALLDIR" ]; then
    echo "wallpaper-shuffle: no such pack: $WALLDIR" >&2
    exit 1
fi

# -n: don't filter by size. The old awww path never filtered either, and
# caelestia's default threshold silently rejects packs of small images.
caelestia wallpaper -n -r "$WALLDIR" || exit 1

~/.local/bin/caelestia-theme
